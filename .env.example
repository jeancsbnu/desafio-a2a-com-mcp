# Variaveis de ambiente da entrega. Nada carrega este arquivo sozinho:
# exporte no terminal, como mostra o README. Nunca commite o valor real.

# Obrigatoria no servidor MCP: chave de integridade do requestState, >= 32 bytes aleatorios.
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
REQUEST_STATE_SECRET=

# Opcionais (valores padrao)
# MCP_HOST=localhost
# MCP_PORT=7301
# AGENTE_HOST=localhost
# AGENTE_PORT=7300
# MCP_URL=http://localhost:7301/mcp
# AGENTE_URL_PUBLICA=http://localhost:7300
